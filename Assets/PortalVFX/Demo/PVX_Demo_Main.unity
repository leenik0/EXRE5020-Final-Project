GameObject:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  serializedVersion: 6
  m_Component:
  - component: {fileID: 424755779}
  - component: {fileID: 424755778}
  m_Layer: 0
  m_Name: ZonesGuide
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &424755778
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 424755777}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3348df8608ed4b99bb5840b10448afd9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  player: {fileID: 256751056}
  zones:
  - title: Spawn Plaza
    description: Welcome to Portal VFX. Walk with WASD, click to capture the mouse.
      Walk into any portal to teleport, E re-opens the nearest one, F throws a ball,
      C recolours. Number keys jump between zones.
    center: {x: 0, y: 0, z: 0}
    radius: 13
    spawn: {x: 0, y: 0, z: -4}
    spawnYaw: 0
  - title: Portal Avenue
    description: 'Eighteen of the 72 portals. Each one lights the wet floor around
      it (PVXPortalLight), reacts as you come close (PVXProximity) and opens with
      its own staging. Walk into one: you dissolve and rebuild in front of it.'
    center: {x: 0, y: 0, z: 84}
    radius: 70
    spawn: {x: 0, y: 0, z: 14}
    spawnYaw: 0
  - title: Teleport + Portal Link
    description: 'PVXPortalLink pairs two portals: each shows a live view out of
      the other, and anything with PVXTeleportable that walks in dissolves here and
      rebuilds at the other one.'
    center: {x: 40, y: 0, z: 26}
    radius: 12
    spawn: {x: 40, y: 0, z: 19}
    spawnYaw: 0
  - title: Colour Presets + Quick Settings
    description: Every portal has PVXColorPresets (original + three variants) and
      quick Size, Speed, Tint and Brightness settings on PVXPortal. The same Classic
      Fire portal shows all four presets.
    center: {x: 64, y: 0, z: 26}
    radius: 12
    spawn: {x: 64, y: 0, z: 19}
    spawnYaw: 0
  - title: Summoning
    description: 'PVXSummon raises a creature out of a portal and dissolves it away
      again: a familiar from the summoning circle, a hero on the spawn pad, and a
      hand-sized portal for loot and pets.'
    center: {x: 88, y: 0, z: 26}
    radius: 12
    spawn: {x: 88, y: 0, z: 20}
    spawnYaw: 0
  - title: Gravity Well
    description: 'PVXGravityWell pulls rigidbodies into an open portal: crates and
      barrels spiral in, shrink and vanish, then respawn. Throw balls at it with
      F.'
    center: {x: 112, y: 0, z: 26}
    radius: 12
    spawn: {x: 112, y: 0, z: 17}
    spawnYaw: 0
  - title: Objects Through Portals
    description: Rigidbodies that fly into a linked portal come out of the other
      with the same speed, turned to match. Balls go into the water portal and shoot
      out of the fire portal.
    center: {x: 136, y: 0, z: 26}
    radius: 12
    spawn: {x: 130, y: 0, z: 18}
    spawnYaw: 0
  - title: 'Dungeon: Gameplay Helpers'
    description: A hall lit only by portals. Find the rune key to open the sealed
      door (PVXPortalTrigger + PVXKeyPickup); its onOpening event lights the braziers.
      Throw a ball into the wall portal and it drops from the ceiling (PVXMount).
      The unstable portal keeps collapsing (PVXUnstable).
    center: {x: -60, y: 0, z: 40}
    radius: 24
    spawn: {x: -60, y: 0, z: 14}
    spawnYaw: 0
  - title: Extras Garden
    description: 'Mix-and-match extras: 20 ground runes, 20 trails, 10 frames and
      10 destination reveals. Combine them with any portal in Tools > Portal VFX
      > Portal Constructor.'
    center: {x: 0, y: 0, z: 172}
    radius: 28
    spawn: {x: 0, y: 0, z: 144}
    spawnYaw: 0
