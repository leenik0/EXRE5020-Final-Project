MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 602851283}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ee419233baccd54eab7e000cb60a7b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cam: {fileID: 390859030}
  stations:
  - title: Teleport + Portal Link
    description: 'PVXPortalLink pairs two portals: each shows a live view out of
      the other, and anything with PVXTeleportable that walks in dissolves here and
      rebuilds in front of the other portal (PortalVFX/Dissolve shader keeps the
      character''s own texture).'
    cameraPosition: {x: 0, y: 3.2, z: -12}
    lookAt: {x: 0, y: 1.8, z: 0}
  - title: Proximity Reaction
    description: 'PVXProximity makes a portal answer whoever approaches: it glows
      brighter and its idle particles thicken as the target gets close, then calms
      down again. Set any Transform as the target (defaults to the main camera).'
    cameraPosition: {x: 24, y: 4, z: -12}
    lookAt: {x: 24, y: 1.8, z: 0}
  - title: Colour Presets
    description: 'Every portal has PVXColorPresets: the original look plus three
      colour variants, one click in the inspector or Apply(index) from code. Here
      the same Classic Fire portal shows all four, and they keep cycling.'
    cameraPosition: {x: 48, y: 3.2, z: -13}
    lookAt: {x: 48, y: 1.8, z: 0}
  - title: Summon Circle, Spawn Point, Mini Portal
    description: 'Small gameplay portals with PVXSummon: a familiar rises out of
      the summoning circle, a hero materialises on the spawn pad, and a hand-sized
      portal for loot, pets and projectiles. They flash on Teleport() like the big
      ones.'
    cameraPosition: {x: 72, y: 3.2, z: -11}
    lookAt: {x: 72, y: 1.8, z: 0}
  - title: Open / Close Staging
    description: Every portal opens with sparks gathering into a seed, a bright tear
      in the air and a shockwave over the ground, and closes with a ground shock
      and a fading afterglow. Call Open(), Teleport() and Close() on PVXPortal.
    cameraPosition: {x: 96, y: 3.2, z: -12}
    lookAt: {x: 96, y: 1.8, z: 0}
  - title: Gravity Well
    description: 'PVXGravityWell pulls nearby rigidbodies into an open portal: crates,
      barrels and rocks spiral in, shrink and vanish in the core. With Respawn on
      (as here) they come back after a moment. Added to the vortex portals; works
      on any portal.'
    cameraPosition: {x: 120, y: 4.5, z: -13}
    lookAt: {x: 120, y: 1.8, z: 0}
  - title: Objects Through Portals
    description: With PVXPortalLink, rigidbodies that fly into one portal come out
      of the other with the same speed, turned to match it. Here balls are thrown
      into the water portal and shoot out of the fire portal.
    cameraPosition: {x: 144, y: 3.2, z: -13}
    lookAt: {x: 144, y: 1.8, z: 0}
  autoTour: 1
  stationTime: 12
  moveTime: 1.6
